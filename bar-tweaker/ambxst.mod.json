{
  "manifestVersion": 1,
  "id": "deprecatedluar.bar-tweaker",
  "name": "Bar Tweaker",
  "version": "0.1.0",
  "license": "MIT",
  "author": "DeprecatedLuar",
  "description": "Makes the vertical bar's widget layout configurable via ~/.config/ambxst/config/mods/bar-tweaker/layout.json instead of hardcoded QML.",
  "permissions": [
    "Reads and writes its own bar layout config file"
  ],
  "compatibility": {
    "api": 1,
    "ambxst": ">=1.3.0 <1.4.0",
    "testedBaseCommits": [
      "af9f8ad4f42d7cd77f57a7c75f6a2a5d1fb59674"
    ]
  },
  "operations": [
    {
      "type": "overlay",
      "source": "payload/tweaker/PinButton.qml",
      "target": "modules/bar/tweaker/PinButton.qml"
    },
    {
      "type": "overlay",
      "source": "payload/tweaker/BarTweaks.qml",
      "target": "modules/bar/tweaker/BarTweaks.qml"
    },
    {
      "type": "overlay",
      "source": "payload/tweaker/BarWidgetMap.qml",
      "target": "modules/bar/tweaker/BarWidgetMap.qml"
    },
    {
      "type": "overlay",
      "source": "payload/tweaker/BarTweakerEngine.qml",
      "target": "modules/bar/tweaker/BarTweakerEngine.qml"
    },
    {
      "type": "patch",
      "source": "patches/hook.patch"
    }
  ]
}
