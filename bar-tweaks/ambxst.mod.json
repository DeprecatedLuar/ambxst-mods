{
  "manifestVersion": 1,
  "id": "luar.bar-tweaks",
  "name": "Bar Tweaks",
  "version": "0.1.0",
  "license": "MIT",
  "author": "DeprecatedLuar",
  "description": "Makes the vertical bar's widget layout configurable via a JSON file instead of hardcoded QML.",
  "permissions": [
    "Reads and writes its own bar layout config file"
  ],
  "compatibility": {
    "api": 1,
    "ambxst": ">=1.3.0 <1.4.0",
    "testedBaseCommits": [
      "af9f8ad4f42d7cd77f57a7c75f6a2a5d1fb59674"
    ]
  },
  "operations": [
    {
      "type": "overlay",
      "source": "payload/BarContent.qml",
      "target": "modules/bar/BarContent.qml",
      "replace": true,
      "expectedSha256": "ce5c2c32a9b81a2ac358319d74028f906357f289c3ddc90d8dc4d28f59fdd0d9"
    },
    {
      "type": "overlay",
      "source": "payload/PinButton.qml",
      "target": "modules/bar/PinButton.qml"
    },
    {
      "type": "overlay",
      "source": "payload/BarTweaks.qml",
      "target": "modules/bar/BarTweaks.qml"
    },
    {
      "type": "overlay",
      "source": "payload/BarWidgetMap.qml",
      "target": "modules/bar/BarWidgetMap.qml"
    }
  ]
}
